{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/ws.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/race",
      "destination": "/race.html"
    },
    {
      "source": "/.admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
