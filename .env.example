# Local server port
PORT=3000

# Paste your Redis connection URL here (rediss://...), not the REST API URL.
# This is ignored locally unless USE_REDIS_LOCALLY=true.
REDIS_URL=

# Set true only when explicitly testing the local Redis backend.
USE_REDIS_LOCALLY=false

# Keep local testing separate from the production race.
RACE_ROOM=local

# Private key (any non-empty word or phrase) for presenter controls.
PRESENTER_KEY=

# Optional extra exact origins, comma-separated (no trailing slash).
# Set this to your site origin in Vercel if not using its automatic domains.
ALLOWED_ORIGINS=
